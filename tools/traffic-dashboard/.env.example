# Create at https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxx

# Web service ID (dashboard URL: .../srv-xxxxxxxx)
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx

# Workspace / owner ID (dashboard → Account Settings, or leave empty to auto-detect)
RENDER_OWNER_ID=

# How often to pull new logs from Render (ms)
POLL_INTERVAL_MS=8000

# Rolling window shown on dashboard (hours)
LOG_WINDOW_HOURS=24

# Dashboard port (run locally; do not expose API key publicly)
DASHBOARD_PORT=3456
