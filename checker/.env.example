# Copy to .env. Do not commit real keys.

PORT=8787
TARGET_BASE_URL=https://omegax-hackathon.onrender.com

# Optional. If unset, the UI still accepts pasted answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Pack-based Accuracy Test (POST /api/runs). Default is the Acme Pump demo.
# Use apex to load checker/data/reference/apex.json and data/questions/apex.json.
CHECKER_PACK=demo

# Optional path overrides. Ignored when CHECKER_PACK is set, so the named pair
# cannot be mixed by accident. Use these only when CHECKER_PACK is unset.
# QUESTIONS_PATH=data/questions/demo.json
# REFERENCE_PATH=data/reference/demo.json
